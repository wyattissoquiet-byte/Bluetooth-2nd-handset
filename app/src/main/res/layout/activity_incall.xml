<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="8dp">

    <TextView
        android:id="@+id/incall_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:text="@string/state_active" />

    <TextView
        android:id="@+id/incall_caller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="@color/fg"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="@string/unknown_number" />

    <Chronometer
        android:id="@+id/incall_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/fg_dim"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_mute"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/btn_focus"
            android:textColor="@color/fg"
            android:textSize="13sp"
            android:focusable="true"
            android:text="@string/mute" />

        <Button
            android:id="@+id/btn_speaker"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_focus"
            android:textColor="@color/fg"
            android:textSize="13sp"
            android:focusable="true"
            android:text="@string/speaker" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_audio"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/btn_focus"
        android:textColor="@color/fg"
        android:textSize="13sp"
        android:focusable="true"
        android:text="@string/audio_to_fresno" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btn_end"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/btn_red"
        android:textColor="@color/fg"
        android:textSize="17sp"
        android:textStyle="bold"
        android:focusable="true"
        android:text="@string/end_call" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="3dp"
        android:textColor="@color/fg_dim"
        android:textSize="10sp"
        android:text="@string/incall_hint" />
</LinearLayout>
