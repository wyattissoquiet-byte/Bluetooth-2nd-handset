<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/host_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/fg"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@string/no_device" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:paddingBottom="4dp"
            android:text="@string/status_disconnected" />

        <Button
            android:id="@+id/btn_connect"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/btn_green"
            android:textColor="@color/fg"
            android:textSize="16sp"
            android:focusable="true"
            android:text="Connect" />

        <Button
            android:id="@+id/btn_pair"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/btn_focus"
            android:textColor="@color/fg"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:focusable="true"
            android:text="@string/menu_pair" />

        <Button
            android:id="@+id/btn_dial"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/btn_focus"
            android:textColor="@color/fg"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:focusable="true"
            android:text="@string/menu_dial" />

        <Button
            android:id="@+id/btn_settings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/btn_focus"
            android:textColor="@color/fg"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:focusable="true"
            android:text="@string/menu_settings" />

        <Button
            android:id="@+id/btn_setup"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/btn_focus"
            android:textColor="@color/fg"
            android:textSize="15sp"
            android:gravity="start|center_vertical"
            android:paddingStart="10dp"
            android:focusable="true"
            android:text="@string/menu_setup" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="6dp"
            android:textColor="@color/fg_dim"
            android:textSize="12sp"
            android:text="@string/main_hint" />
    </LinearLayout>
</ScrollView>
