    <!-- Setup wizard -->
    <string name="setup_bt_title">Step 1 of 6: Bluetooth</string>
    <string name="setup_bt_body">The gateway needs Bluetooth permission to talk to your host phone.\n\nPress OK, then choose Allow.</string>
    <string name="setup_phone_title">Step 2 of 6: Phone</string>
    <string name="setup_phone_body">Phone and microphone permissions let this app also place and answer calls on the Fresno\'s own SIM.\n\nPress OK, then choose Allow.</string>
    <string name="setup_dialer_title">Step 3 of 6: Phone app</string>
    <string name="setup_dialer_body">Set Fresno Gateway as the default Phone app so it can show the call screen for SIM calls too.\n\nOptional — skip with the Skip button if you prefer the built-in dialer.</string>
    <string name="setup_overlay_title">Step 4 of 6: Popups</string>
    <string name="setup_overlay_body">Allow "display over other apps" so the incoming-call screen appears instantly when the host phone rings.\n\nTurn the switch ON, then press Back.</string>
    <string name="setup_battery_title">Step 5 of 6: Battery</string>
    <string name="setup_battery_body">Allow the app to ignore battery optimizations so the Bluetooth link stays alive with the flip closed.\n\nChoose Allow.</string>
    <string name="setup_host_title">Step 6 of 6: Host phone</string>
    <string name="setup_host_body">First pair your main phone in the Fresno\'s Settings &gt; Connected devices &gt; Bluetooth.\n\nThen press OK to select it as the host.</string>
